# Path to the fine-tuned checkpoint. If the file is missing it is downloaded
# from WEIGHTS_URL on first start (a GitHub release asset; no account needed).
MODEL_WEIGHTS=artifacts/best.pt
WEIGHTS_URL=https://github.com/KanagavelAK/aquarium-rtdetr/releases/download/v1.0/best.pt
# Optional alternative source: a public Kaggle dataset owner/slug holding best.pt
# WEIGHTS_KAGGLE_DATASET=

# Detection defaults
CONF_THRESHOLD=0.25
IMGSZ=640
# Leave empty to let Ultralytics pick a device; set to cpu to force CPU inference
DETECTOR_DEVICE=

# Guardrail. Detections weaker than the floor cannot support an assertion; a
# count is refused when more than CROWDING_MAX of a class's boxes overlap a
# neighbour of the same class, or fewer than CONFIDENT_FRACTION_MIN clear the
# floor; a ranking is refused when the top two counts are within RANK_MARGIN_FRACTION.
LOW_CONFIDENCE_FLOOR=0.45
CROWDING_MAX=0.34
CONFIDENT_FRACTION_MIN=0.5
RANK_MARGIN_FRACTION=0.15

# Optional. Without it the reasoning layer answers from templates.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=12582912
